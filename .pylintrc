[MAIN]
py-version=3.10
ignore=venv,test_images,.github
# Fail the check if the score drops below 9/10
fail-under=9.0

[TYPECHECK]
# TensorFlow/Keras load their modules lazily, which makes Pylint
# report false "no-name-in-module" errors, so we skip type-checking them
ignored-modules=tensorflow,keras

[FORMAT]
max-line-length=100

[MESSAGES CONTROL]
disable=